PORT=3000

MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<your-cluster>.mongodb.net/portfolio?retryWrites=true&w=majority&appName=Cluster0

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=EXAMPLE_NOT_A_REAL_SECRET_CHANGE_ME

# First admin account, created only when the database has no admin users yet.
# The password needs 8+ characters (three kinds of character, or 16+ characters).
# Afterwards manage accounts and passwords in the admin portal.
ADMIN_USERNAME=EXAMPLE_ADMIN_USERNAME
ADMIN_PASSWORD=EXAMPLE_ADMIN_PASSWORD

# Public address used in canonical URLs, the sitemap and email links.
# Netlify sets URL automatically; set this for a custom domain.
SITE_URL=

# Every admin must use two-step verification (set to false to allow sign-in without it)
REQUIRE_MFA=true
# How long an admin stays signed in
SESSION_HOURS=12

# Email (any SMTP provider: Gmail app password, Resend, Brevo, Postmark...).
# Used for contact-form notifications, password reset links and security alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Portfolio <no-reply@example.com>"
NOTIFY_EMAIL=

# Optional chat alerts (Slack or Discord incoming webhook URL)
ALERT_WEBHOOK_URL=

# Optional Cloudflare Turnstile bot check on the contact form (both keys needed)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Google Analytics 4 ID (G-XXXXXXX); loaded only after visitors accept cookies
GA_MEASUREMENT_ID=

# Only if the admin is hosted on a different domain than the API
ALLOWED_ORIGINS=
