PORT=3000
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<your-cluster>.mongodb.net/portfolio?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# First admin account, created only when the database has no admin users yet.
# Afterwards manage accounts and passwords in the admin portal.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=change-this-to-a-strong-password
