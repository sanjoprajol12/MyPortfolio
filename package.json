{
  "name": "prajwal-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio site with MongoDB-backed admin portal",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js",
    "build": "npm --prefix admin-ui ci && npm --prefix admin-ui run build",
    "dev:admin": "npm --prefix admin-ui run dev"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.6.0",
    "mongoose": "^8.13.0",
    "multer": "^1.4.5-lts.2",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "serverless-http": "^4.0.0"
  }
}
